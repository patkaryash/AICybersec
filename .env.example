# AICybersec backend configuration.
# Copy to .env and adjust for your environment. NEVER commit .env.
# All variables use the AICYBERSEC_ prefix. Development defaults below are
# safe for local/lab use only - never provide production secrets here.

# --- Database (PostgreSQL + psycopg 3 driver) ---
AICYBERSEC_DATABASE_URL=postgresql+psycopg://aicybersec:aicybersec@localhost:5432/aicybersec

# --- Auth / JWT ---
# CHANGE THESE in any shared environment. The dev default is deliberately insecure.
AICYBERSEC_JWT_SECRET=dev-insecure-jwt-secret-change-me
AICYBERSEC_JWT_EXPIRY_S=86400
# Default admin seeded on startup when the user does not exist yet (lab convenience).
AICYBERSEC_ADMIN_EMAIL=admin@aicybersec.dev
AICYBERSEC_ADMIN_PASSWORD=admin-dev-password-change-me

# --- CORS ---
# Comma-separated list of allowed frontend origins. Never use "*" with credentials.
AICYBERSEC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limits ---
AICYBERSEC_MAX_CONCURRENT_SCANS=2
AICYBERSEC_DEFAULT_TOOL_TIMEOUT_S=300
AICYBERSEC_MAX_TOOL_OUTPUT_BYTES=524288

# --- Scan execution (Phase 3) ---
# 1 = POST /scans submits to the ScanManager immediately (production).
# 0 = scans stay queued (tests, maintenance).
AICYBERSEC_SCAN_AUTO_START=1

# --- Runtime artifacts (agent state, trajectory, raw tool output on disk) ---
AICYBERSEC_RUNS_DIR=runs

# --- Phase 5: live website assessment (opt-in; Stage 1 = records only) ---
# MUST default to false. Stage 1 ships authorization records + immutable
# per-scan snapshots ONLY - no live HTTP execution exists yet regardless
# of this flag (the ScanManager hard-refuses live_probe scans).
AICYBERSEC_LIVE_PROBE_ENABLED=0
# Policy version stamped onto authorizations/snapshots; bumping it
# invalidates every existing live authorization (fail closed).
AICYBERSEC_LIVE_PROBE_POLICY_VERSION=live-probe/v1
# Maximum authorization lifetime in days (admin can always set shorter).
AICYBERSEC_LIVE_PROBE_MAX_AUTHORIZATION_DAYS=90

# --- AI provider (Phase 8; no external LLM is needed before then) ---
# mock | openai_compatible
AICYBERSEC_PROVIDER=mock
AICYBERSEC_AI_BASE_URL=
AICYBERSEC_AI_MODEL=
AICYBERSEC_AI_API_KEY=

# --- agent_core defaults (CLI demo and scripted/agent runs) ---
AICYBERSEC_ALLOWED_TARGETS=
AICYBERSEC_MAX_DANGER=active_scan
AICYBERSEC_DEFAULT_MODE=recon
AICYBERSEC_MAX_STEPS=12
AICYBERSEC_TOOL_TIMEOUT_S=60
